import streamlit as st
import mysql.connector

# Configuração da conexão com o banco de dados
def init_connection():
    return mysql.connector.connect(
        host="localhost",
        user="seu_usuario",
        password="sua_senha",
        database="seu_banco"
    )

db = init_connection()
cursor = db.cursor()

st.title("Gerenciamento de Clientes")

# Menu lateral para navegação
menu = ["Cadastrar", "Listar/Editar"]
escolha = st.sidebar.selectbox("Menu", menu)

if escolha == "Cadastrar":
    st.subheader("Cadastrar Novo Cliente")
    
    nome = st.text_input("Nome do Cliente")
    email = st.text_input("E-mail")
    telefone = st.text_input("Telefone")
    
    if st.button("Salvar"):
        if nome and email:
            cursor.execute(
                "INSERT INTO clientes (nome, email, telefone) VALUES (%s, %s, %s)",
                (nome, email, telefone)
            )
            db.commit()
            st.success("Cliente cadastrado com sucesso!")
        else:
            st.error("Preencha pelo menos o nome e o e-mail.")

elif escolha == "Listar/Editar":
    st.subheader("Lista e Edição de Clientes")
    
    cursor.execute("SELECT id, nome, email, telefone FROM clientes")
    clientes = cursor.fetchall()
    
    if not clientes:
        st.info("Nenhum cliente cadastrado.")
    else:
        for cliente in clientes:
            id_cliente, nome, email, telefone = cliente
            
            with st.expander(f"{nome} (ID: {id_cliente})"):
                with st.form(key=f"form_{id_cliente}"):
                    novo_nome = st.text_input("Nome", value=nome)
                    novo_email = st.text_input("E-mail", value=email)
                    novo_telefone = st.text_input("Telefone", value=telefone if telefone else "")
                    
                    atualizar = st.form_submit_button("Atualizar")
                    
                    if atualizar:
                        cursor.execute(
                            "UPDATE clientes SET nome = %s, email = %s, telefone = %s WHERE id = %s",
                            (novo_nome, novo_email, novo_telefone, id_cliente)
                        )
                        db.commit()
                        st.success(f"Cliente {id_cliente} atualizado com sucesso!")
                        st.rerun()
